---
import type { MarkdownHeading } from "astro";
import TableOfContents from "./TableOfContents.astro";

interface Props {
  title: string;
  date?: string;
  readingTime?: string;
  category?: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const {
  title,
  date,
  readingTime,
  category,
  description,
  headings = [],
} = Astro.props;
---

<div class="reading-progress" aria-hidden="true">
  <div class="reading-progress-bar" data-reading-progress></div>
</div>

<div class="article-wrapper">
  <article class="article-content">
    <header class="article-header">
      {
        category && (
          <div class="article-category">
            <span class="category-badge">{category}</span>
          </div>
        )
      }

      <h1 class="article-title">{title}</h1>

      {description && <p class="article-description">{description}</p>}

      {
        (date || readingTime) && (
          <div class="article-meta">
            {date && (
              <div class="meta-item">
                <svg
                  class="meta-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                <span>{date}</span>
              </div>
            )}
            {readingTime && (
              <div class="meta-item">
                <svg
                  class="meta-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <span>{readingTime}</span>
              </div>
            )}
          </div>
        )
      }
    </header>

    <div class="article-divider"></div>

    <div class="article-body" data-article-body>
      <slot />
    </div>
  </article>

  <TableOfContents headings={headings} />
</div>

<script>
  // Reading-progress bar bound to the article body
  function setupReadingProgress() {
    const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
    const body = document.querySelector<HTMLElement>("[data-article-body]");
    if (!bar || !body) return () => {};

    let ticking = false;
    const update = () => {
      const rect = body.getBoundingClientRect();
      const viewH = window.innerHeight;
      const total = Math.max(1, rect.height - viewH);
      const scrolled = Math.min(Math.max(-rect.top, 0), total);
      const pct = (scrolled / total) * 100;
      bar.style.width = `${pct}%`;
      ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
    return () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
    };
  }

  // Copy buttons + language labels on code blocks
  function setupCodeBlocks() {
    const blocks = document.querySelectorAll<HTMLPreElement>(
      ".article-body pre"
    );

    blocks.forEach((pre) => {
      if (pre.querySelector(".code-toolbar")) return;

      const code = pre.querySelector("code");
      const lang =
        code &&
        Array.from(code.classList)
          .find((c) => c.startsWith("language-"))
          ?.replace("language-", "");

      const toolbar = document.createElement("div");
      toolbar.className = "code-toolbar";

      if (lang) {
        const label = document.createElement("span");
        label.className = "code-lang";
        label.textContent = lang;
        toolbar.appendChild(label);
      }

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "code-copy";
      btn.setAttribute("aria-label", "Copy code");
      btn.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      btn.addEventListener("click", async () => {
        const text = pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("copied");
          btn.setAttribute("aria-label", "Copied");
          setTimeout(() => {
            btn.classList.remove("copied");
            btn.setAttribute("aria-label", "Copy code");
          }, 1500);
        } catch {
          /* clipboard unavailable */
        }
      });
      toolbar.appendChild(btn);
      pre.appendChild(toolbar);
    });
  }

  // Smooth-scroll for in-page anchor links so the sticky header has room
  function setupAnchorSmoothScroll() {
    const handler = (e: MouseEvent) => {
      const t = e.target as HTMLElement;
      const link = t.closest("a[href^='#']") as HTMLAnchorElement | null;
      if (!link) return;
      const id = link.getAttribute("href")?.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      const y = target.getBoundingClientRect().top + window.scrollY - 24;
      window.scrollTo({ top: y, behavior: "smooth" });
      history.replaceState(null, "", `#${id}`);
    };
    document.addEventListener("click", handler);
    return () => document.removeEventListener("click", handler);
  }

  let cleanupProgress: (() => void) | undefined;
  let cleanupAnchors: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    cleanupProgress?.();
    cleanupAnchors?.();
    cleanupProgress = setupReadingProgress();
    cleanupAnchors = setupAnchorSmoothScroll();
    setupCodeBlocks();
  });
  document.addEventListener("astro:before-swap", () => {
    cleanupProgress?.();
    cleanupAnchors?.();
  });
</script>

<style>
  /* ---------- Reading progress ---------- */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: 100;
    pointer-events: none;
  }
  .reading-progress-bar {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, #4a9eff, #6bb3ff);
    transition: width 0.05s linear;
    box-shadow: 0 0 8px rgba(74, 158, 255, 0.55);
  }

  /* ---------- Layout: article + TOC ---------- */
  .article-wrapper {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    animation: fadeIn 0.6s ease-out;
  }

  @media (min-width: 1100px) {
    .article-wrapper {
      grid-template-columns: minmax(0, 1fr) 240px;
      align-items: start;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .article-content {
    width: 100%;
    max-width: 880px;
    margin: 0;
    background: transparent;
    padding: 0;
    position: relative;
  }

  /* When the TOC is hidden (single-column), center the prose column. */
  @media (max-width: 1099px) {
    .article-content {
      margin: 0 auto;
    }
  }

  /* ---------- Header ---------- */
  .article-header {
    margin-bottom: 2rem;
  }

  .article-category {
    margin-bottom: 1rem;
  }

  .category-badge {
    display: inline-block;
    background: rgba(74, 158, 255, 0.15);
    color: #4a9eff;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.375rem 0.875rem;
    border-radius: 20px;
    border: 1px solid rgba(74, 158, 255, 0.3);
  }

  .article-title {
    color: #fff;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 2.5rem;
    font-weight: 500;
    letter-spacing: -0.5px;
    line-height: 1.15;
    margin: 0 0 1rem 0;
  }

  .article-description {
    color: #a8a8a8;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    font-weight: 300;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #a8a8a8;
    font-size: 0.875rem;
    font-family: "IBM Plex Mono", monospace;
  }

  .meta-icon {
    width: 16px;
    height: 16px;
    color: #656565;
  }

  .article-divider {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #353535 20%,
      #454545 50%,
      #353535 80%,
      transparent 100%
    );
    margin: 2rem 0;
  }

  /* ---------- Body prose ---------- */
  .article-body {
    color: #d4d4d4;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .article-body :global(h1),
  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4),
  .article-body :global(h5),
  .article-body :global(h6) {
    color: #fff;
    font-family: "IBM Plex Sans", sans-serif;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    scroll-margin-top: 1.5rem;
    position: relative;
  }

  .article-body :global(h2) {
    font-size: 1.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #2a2a2a;
  }

  .article-body :global(h3) {
    font-size: 1.375rem;
  }

  .article-body :global(h4) {
    font-size: 1.125rem;
  }

  /* Heading anchor link from rehype-autolink-headings */
  .article-body :global(.heading-anchor) {
    margin-left: 0.5rem;
    color: #4a9eff;
    opacity: 0;
    transition: opacity 0.15s ease;
    text-decoration: none;
    font-weight: 400;
    border-bottom: none;
  }
  .article-body :global(h2:hover .heading-anchor),
  .article-body :global(h3:hover .heading-anchor),
  .article-body :global(h4:hover .heading-anchor),
  .article-body :global(h5:hover .heading-anchor),
  .article-body :global(h6:hover .heading-anchor) {
    opacity: 1;
  }
  .article-body :global(.heading-anchor-icon) {
    font-family: "IBM Plex Mono", monospace;
  }

  .article-body :global(p) {
    margin-bottom: 1.5rem;
    color: #c5c5c5;
  }

  .article-body :global(a) {
    color: #4a9eff;
    text-decoration: none;
    border-bottom: 1px dashed rgba(74, 158, 255, 0.4);
    transition: all 0.2s ease;
  }

  .article-body :global(a:hover) {
    color: #6bb3ff;
    border-bottom-color: #6bb3ff;
  }

  .article-body :global(strong) {
    color: #fff;
    font-weight: 600;
  }

  .article-body :global(em) {
    color: #d4d4d4;
    font-style: italic;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
    color: #c5c5c5;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  .article-body :global(ul li::marker) {
    color: #4a9eff;
  }

  .article-body :global(ol li::marker) {
    color: #4a9eff;
    font-weight: 600;
  }

  /* Task lists */
  .article-body :global(li input[type="checkbox"]) {
    margin-right: 0.5rem;
    accent-color: #4a9eff;
  }

  /* ---------- Blockquote ---------- */
  .article-body :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    background: rgba(74, 158, 255, 0.06);
    border-left: 4px solid #4a9eff;
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #b8b8b8;
  }

  .article-body :global(blockquote p) {
    margin-bottom: 0;
  }

  /* GitHub-style callouts via blockquote convention:
     > [!NOTE] / [!TIP] / [!WARNING] / [!IMPORTANT] / [!CAUTION]
     Rendered as plain text; we style via :has() + first line markers below.
     For markdown libraries that don't transform them, we ship a small JS
     enhancer baked into setupCodeBlocks could pick them up — but to keep
     dependencies light we provide an .callout helper class for MDX use. */
  .article-body :global(.callout) {
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    border-left: 4px solid;
    background: rgba(255, 255, 255, 0.02);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .article-body :global(.callout .callout-title) {
    font-weight: 600;
    color: #fff;
    font-family: "IBM Plex Sans", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
    grid-column: 1 / -1;
    margin-bottom: -0.25rem;
  }
  .article-body :global(.callout p) {
    margin: 0.25rem 0 0;
    grid-column: 1 / -1;
    color: #c5c5c5;
  }
  .article-body :global(.callout.note) {
    border-color: #4a9eff;
    background: rgba(74, 158, 255, 0.06);
  }
  .article-body :global(.callout.tip) {
    border-color: #4ade80;
    background: rgba(74, 222, 128, 0.06);
  }
  .article-body :global(.callout.warning) {
    border-color: #fbbf24;
    background: rgba(251, 191, 36, 0.06);
  }
  .article-body :global(.callout.danger) {
    border-color: #f87171;
    background: rgba(248, 113, 113, 0.06);
  }

  /* ---------- Inline & block code ---------- */
  .article-body :global(code) {
    background: rgba(53, 53, 53, 0.8);
    color: #ff7eb6;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.875em;
    padding: 0.18em 0.4em;
    border-radius: 4px;
    border: 1px solid #404040;
  }

  .article-body :global(pre) {
    background: #0f0f10 !important;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 2.5rem 1.25rem 1.25rem;
    margin: 2rem 0;
    overflow-x: auto;
    position: relative;
  }

  .article-body :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: #d4d4d4;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .article-body :global(.astro-code) {
    background: #0f0f10 !important;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    margin: 2rem 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* Code toolbar (lang label + copy button), injected by JS */
  .article-body :global(.code-toolbar) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: "IBM Plex Mono", monospace;
  }
  .article-body :global(.code-lang) {
    color: #7a7a7a;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid #2a2a2a;
  }
  .article-body :global(.code-copy) {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid #2a2a2a;
    color: #a8a8a8;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .article-body :global(.code-copy svg) {
    width: 14px;
    height: 14px;
  }
  .article-body :global(.code-copy:hover) {
    color: #fff;
    border-color: #4a9eff;
    background: rgba(74, 158, 255, 0.1);
  }
  .article-body :global(.code-copy.copied) {
    color: #4ade80;
    border-color: #4ade80;
    background: rgba(74, 222, 128, 0.1);
  }
  .article-body :global(.code-copy.copied svg) {
    display: none;
  }
  .article-body :global(.code-copy.copied::after) {
    content: "✓";
    font-size: 0.9rem;
  }

  /* ---------- Images & figures ---------- */
  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 2rem 0;
    border: 1px solid #353535;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }
  .article-body :global(figure) {
    margin: 2rem 0;
  }
  .article-body :global(figcaption) {
    color: #8a8a8a;
    font-size: 0.85rem;
    text-align: center;
    margin-top: 0.5rem;
    font-style: italic;
  }

  /* ---------- Tables ---------- */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9rem;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    overflow: hidden;
    display: block;
    overflow-x: auto;
  }

  .article-body :global(th) {
    background: #1a1a1a;
    color: #fff;
    font-weight: 600;
    text-align: left;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid #2a2a2a;
    white-space: nowrap;
  }

  .article-body :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #232323;
    color: #c5c5c5;
  }

  .article-body :global(tr:last-child td) {
    border-bottom: none;
  }

  .article-body :global(tr:hover td) {
    background: rgba(74, 158, 255, 0.04);
  }

  /* ---------- Horizontal rule ---------- */
  .article-body :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #353535 20%,
      #454545 50%,
      #353535 80%,
      transparent 100%
    );
    margin: 3rem 0;
  }

  /* ---------- Math (KaTeX) ---------- */
  .article-body :global(.katex) {
    color: #e6e6e6;
    font-size: 1.05em;
  }
  .article-body :global(.katex-display) {
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .article-body :global(.katex-display > .katex) {
    color: #f0f0f0;
  }

  /* ---------- Keyboard input ---------- */
  .article-body :global(kbd) {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8em;
    color: #fff;
    background: #2a2a2a;
    border: 1px solid #404040;
    border-bottom-width: 2px;
    border-radius: 5px;
  }

  /* ---------- Details / summary ---------- */
  .article-body :global(details) {
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #2a2a2a;
    border-radius: 10px;
  }
  .article-body :global(details summary) {
    cursor: pointer;
    color: #fff;
    font-weight: 500;
  }
  .article-body :global(details[open]) {
    padding-bottom: 1rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .article-wrapper {
      padding: 0 1rem;
      gap: 1rem;
    }

    .article-title {
      font-size: 1.85rem;
    }

    .article-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .article-body {
      font-size: 1rem;
    }

    .article-body :global(h2) {
      font-size: 1.5rem;
    }

    .article-body :global(h3) {
      font-size: 1.25rem;
    }

    .article-body :global(pre) {
      padding: 2.25rem 1rem 1rem;
      margin: 1.5rem 0;
      border-radius: 8px;
    }
  }

  @media (max-width: 480px) {
    .article-title {
      font-size: 1.5rem;
    }
  }
</style>
