---
interface Props {
  title: string;
  date?: string;
  readingTime?: string;
  category?: string;
  description?: string;
}

const { title, date, readingTime, category, description } = Astro.props;
---

<div class="article-wrapper">
  <article class="article-content">
    <!-- Article Header -->
    <header class="article-header">
      {
        category && (
          <div class="article-category">
            <span class="category-badge">{category}</span>
          </div>
        )
      }

      <h1 class="article-title">{title}</h1>

      {description && <p class="article-description">{description}</p>}

      {
        (date || readingTime) && (
          <div class="article-meta">
            {date && (
              <div class="meta-item">
                <svg
                  class="meta-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                <span>{date}</span>
              </div>
            )}
            {readingTime && (
              <div class="meta-item">
                <svg
                  class="meta-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <span>{readingTime}</span>
              </div>
            )}
          </div>
        )
      }
    </header>

    <!-- Divider -->
    <div class="article-divider"></div>

    <!-- Article Body -->
    <div class="article-body">
      <slot />
    </div>
  </article>
</div>

<style>
  .article-wrapper {
    width: 100%;
    max-width: 100%;
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .article-content {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    background: transparent;
    padding: 0;
    position: relative;
  }

  /* Article Header */
  .article-header {
    margin-bottom: 2rem;
  }

  .article-category {
    margin-bottom: 1rem;
  }

  .category-badge {
    display: inline-block;
    background: rgba(74, 158, 255, 0.15);
    color: #4a9eff;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.375rem 0.875rem;
    border-radius: 20px;
    border: 1px solid rgba(74, 158, 255, 0.3);
  }

  .article-title {
    color: #fff;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 2.25rem;
    font-weight: 400;
    letter-spacing: -0.5px;
    line-height: 1.25;
    margin: 0 0 1rem 0;
  }

  .article-description {
    color: #a8a8a8;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    font-weight: 300;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #a8a8a8;
    font-size: 0.875rem;
    font-family: "IBM Plex Mono", monospace;
  }

  .meta-icon {
    width: 16px;
    height: 16px;
    color: #656565;
  }

  /* Divider */
  .article-divider {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #353535 20%,
      #454545 50%,
      #353535 80%,
      transparent 100%
    );
    margin: 2rem 0;
  }

  /* Article Body - Prose Styling */
  .article-body {
    color: #d4d4d4;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 1rem;
    line-height: 1.8;
  }

  /* Global styles for markdown content */
  .article-body :global(h1),
  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4),
  .article-body :global(h5),
  .article-body :global(h6) {
    color: #fff;
    font-family: "IBM Plex Sans", sans-serif;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    position: relative;
  }

  .article-body :global(h2) {
    font-size: 1.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #353535;
  }

  .article-body :global(h3) {
    font-size: 1.375rem;
  }

  .article-body :global(h4) {
    font-size: 1.125rem;
  }

  .article-body :global(p) {
    margin-bottom: 1.5rem;
    color: #c5c5c5;
  }

  .article-body :global(a) {
    color: #4a9eff;
    text-decoration: none;
    border-bottom: 1px dashed rgba(74, 158, 255, 0.4);
    transition: all 0.2s ease;
  }

  .article-body :global(a:hover) {
    color: #6bb3ff;
    border-bottom-color: #6bb3ff;
  }

  .article-body :global(strong) {
    color: #fff;
    font-weight: 600;
  }

  .article-body :global(em) {
    color: #d4d4d4;
    font-style: italic;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
    color: #c5c5c5;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.5rem;
  }

  .article-body :global(ul li::marker) {
    color: #4a9eff;
  }

  .article-body :global(ol li::marker) {
    color: #4a9eff;
    font-weight: 600;
  }

  /* Blockquote styling */
  .article-body :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    background: rgba(74, 158, 255, 0.05);
    border-left: 4px solid #4a9eff;
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #b8b8b8;
  }

  .article-body :global(blockquote p) {
    margin-bottom: 0;
  }

  /* Code styling */
  .article-body :global(code) {
    background: rgba(53, 53, 53, 0.8);
    color: #ff7eb6;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.875em;
    padding: 0.2em 0.4em;
    border-radius: 4px;
    border: 1px solid #404040;
  }

  .article-body :global(pre) {
    background: #1a1a1a;
    border: 1px solid #353535;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2rem 0;
    overflow-x: auto;
    position: relative;
  }

  .article-body :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: #d4d4d4;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* Astro code blocks */
  .article-body :global(.astro-code) {
    background: #1a1a1a !important;
    border: 1px solid #353535;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2rem 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* Images */
  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 2rem 0;
    border: 1px solid #353535;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  /* Tables */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9rem;
  }

  .article-body :global(th) {
    background: #252525;
    color: #fff;
    font-weight: 600;
    text-align: left;
    padding: 0.875rem 1rem;
    border-bottom: 2px solid #404040;
  }

  .article-body :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #353535;
    color: #c5c5c5;
  }

  .article-body :global(tr:hover td) {
    background: rgba(53, 53, 53, 0.3);
  }

  /* Horizontal rule */
  .article-body :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #353535 20%,
      #454545 50%,
      #353535 80%,
      transparent 100%
    );
    margin: 3rem 0;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .article-title {
      font-size: 1.75rem;
    }

    .article-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .article-body {
      font-size: 0.9375rem;
    }

    .article-body :global(h2) {
      font-size: 1.5rem;
    }

    .article-body :global(h3) {
      font-size: 1.25rem;
    }

    .article-body :global(pre) {
      padding: 1rem;
      margin: 1.5rem 0;
      border-radius: 8px;
    }
  }

  @media (max-width: 480px) {
    .article-title {
      font-size: 1.5rem;
    }
  }
</style>
