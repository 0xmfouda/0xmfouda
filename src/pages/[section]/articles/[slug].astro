---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import ArticleContent from "../../../components/ArticleContent.astro";
import { sections, type SectionId } from "../../../sections";

export async function getStaticPaths() {
  const paths = [];
  for (const section of sections) {
    try {
      const articlesEntries = await getCollection(section.id as SectionId);
      if (articlesEntries) {
        for (const entry of articlesEntries) {
          paths.push({
            params: { section: section.id, slug: entry.data.slug },
            props: { entry, section },
          });
        }
      }
    } catch (e) {
      // Collection might not exist yet or be empty
      console.warn(`Could not load collection for section: ${section.id}`, e);
    }
  }
  return paths;
}

type Props = {
  entry: CollectionEntry<SectionId>;
  section: (typeof sections)[number];
};

const { entry, section } = Astro.props;
const { Content, headings } = await render(entry);

// Rough reading-time estimate at ~220 wpm
const wordCount = (entry.body ?? "").trim().split(/\s+/).length;
const minutes = Math.max(1, Math.ceil(wordCount / 220));
const readingTime = `${minutes} min read`;
---

<Layout title={entry.data.title} selectedItem={section.id}>
  <nav class="main main--article">
    <div class="container container--wide">
      <main class="fold-content-container">
        <ArticleContent
          title={entry.data.title}
          date={entry.data.date}
          description={entry.data.desc}
          category={section.name}
          headings={headings}
          readingTime={readingTime}
        >
          <Content />
        </ArticleContent>
      </main>
    </div>
  </nav>
</Layout>

<style is:global>
  /* Override the global 680px cap from public/assets/styles.css for
     article pages only — listing/section pages keep the narrower column. */
  .container--wide {
    max-width: 1240px !important;
  }
  .main--article {
    padding-left: 32px;
    padding-right: 32px;
  }
  @media (max-width: 768px) {
    .main--article {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>
