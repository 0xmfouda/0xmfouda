---
import Layout from "./../layouts/Layout.astro";
import Project from "../components/Project.astro";
import { sections } from "../sections";
---

<Layout title="Mohamed Fouda" selectedItem="home">
  <nav class="main">
    <div class="container">
      <main class="fold-content-container">
        <div class="fold-content">
          <h1>Hi, I'm Mohamed.</h1>
          <h2>I like to build and break things with code & AI.</h2>
          <p class="lead">
            Full-stack developer with experience building web and mobile
            applications. Currently diving deep into the world of Large Language
            Models and how to utlize them effectively in my projects.
          </p>
        </div>
        <a href="mailto:muhammadbadr30@gmail.com" class="button w-button"
          >Contact</a
        >
      </main>
      <div class="projects-section">
        {
          sections.map((section) => (
            <Project
              title={section.name}
              href={`/${section.id}`}
              imageSrc={section.icon}
              imageAlt={section.name}
              technologies={section.technologies || []}
            />
          ))
        }
      </div>
    </div>
  </nav>
</Layout>
